MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes
# Optional SRV/TXT DNS override for Atlas when the system resolver refuses queries.
MONGODB_DNS_SERVERS=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set these only for the explicit seed:admin command. No default credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
