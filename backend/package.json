{
  "name": "secure-notes-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/src/server.js",
    "seed:admin": "tsx --env-file=.env scripts/seed-admin.ts",
    "seed:admin:query": "tsx --env-file=.env scripts/admin-query.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2", "cors": "^2.8.5", "express": "^5.1.0",
    "express-rate-limit": "^8.2.1", "helmet": "^8.1.0", "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0", "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19", "@types/express": "^5.0.5", "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0", "@types/supertest": "^6.0.3", "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4", "tsx": "^4.20.6", "typescript": "^5.9.3"
  }
}
