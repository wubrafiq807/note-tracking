[Unit]
Description=Secure Notes REST API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=secure-notes
Group=secure-notes
WorkingDirectory=/opt/secure-notes/backend
ExecStart=/usr/bin/env node --env-file=.env dist/src/server.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
